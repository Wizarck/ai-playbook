# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Editors
.vscode/
.idea/
*.swp
*~

# Per-developer Claude Code settings (hooks, permissions, etc.)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local artifacts
*.log
.env
.env.local
dist/
build/
site/

# Projects registry (per-dev, never committed)
projects.yaml
# Ignore the *contents* of .ai-playbook/ (notifications.jsonl, overrides.log,
# backups/, caveman.json, etc.). The playbook still dogfoods caveman locally
# — the state file is just NOT committed anymore. Reason: when this repo is
# mounted as a submodule, any tracked file under `.ai-playbook/` appears
# nested as `<consumer>/.ai-playbook/.ai-playbook/<file>` in the consumer's
# tree, which operators read as "inception" pollution. Untrack ⇒ no nesting.
.ai-playbook/*
.ai-playbook-state/
overrides.log

# Consumer-side state spillover into the submodule root.
# When this repo is mounted as a submodule at `<consumer>/.ai-playbook/`,
# the consumer's caveman/rules-toggle/apply_config scripts write state at
# `<consumer>/.ai-playbook/<file>` — which from the submodule's perspective
# appears at the submodule ROOT and pollutes `git status` there. Anchor each
# pattern to the .gitignore root with `/` so standalone playbook checkouts
# are unaffected (these names never appear at `<playbook>/` proper).
/caveman.json
/graphify.json
/ponytail.json
/backups/
/rules-toggle.json
/rules-toggle-audit.jsonl
/feature-flags.env
/events.jsonl
/.caveman-statusline-suffix

# Consumers registry (per-org, never committed — see consumers.yaml.example
# for the schema; copy to consumers.yaml locally and fill in real data).
consumers.yaml

# Runtime notifications (append-only, per-consumer; should never enter the repo)
notifications.jsonl
hindsight-queue.jsonl

# OpenSpec working tree — devs may use the openspec workflow locally while
# iterating on the playbook itself, but the playbook does not commit its own
# proposals/tasks/archive. Consumer-side `openspec/` folders are governed by
# each consumer's own .gitignore (not this file).
openspec/

# BMAD planning artifacts (workflow trail, per-dev scratch). Canonical durable
# artefacts produced by BMAD skills (PRDs, ADRs, slicing) get promoted to
# docs/. See docs/concepts/bmad-openspec-bridge.md §2 (path canon).
_bmad-output/

# Local scratch / research notes (per-dev, never committed). Conversation
# analyses, exploratory write-ups, anything that's "thinking out loud" and
# would otherwise rot in the repo or leak personal context if shipped.
.temp/

# Per-run report written by `cleanup-zombies.rule.py` into the consumer tree.
# When the playbook dogfoods on itself the consumer tree IS this repo, so the
# report lands here. Regenerated on every `--apply`; never a source artefact.
zombie-report.md

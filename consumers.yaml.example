# ai-playbook consumers registry — EXAMPLE / TEMPLATE.
#
# This file is the schema template. Copy it to `consumers.yaml` (gitignored)
# and fill in your actual downstream consumer repos. Automation never reads
# `consumers.yaml.example`; it reads `consumers.yaml`. Missing -> automation
# fails with a clear error pointing back here.
#
# Distinct from `~/.ai-playbook/projects.yaml` (per-dev, gitignored) which
# maps project names to local filesystem paths for dispatcher resolution.
# `consumers.yaml` enumerates every downstream repo that consumes the playbook
# as a git submodule, so automation (GitHub Actions, LangGraph workflows)
# can open "bump playbook pin" PRs across the whole inventory when a new
# tag is cut.
#
# Add a consumer: edit your local `consumers.yaml` (gitignored).
# Remove a consumer: edit your local `consumers.yaml`.
# The schema versioning lives here; bump `schema:` when fields evolve.
#
# Schema
# ------
#   schema: ai-playbook/consumers/v1
#   consumers:
#     <name>:
#       repo: <org>/<name>              # GitHub slug
#       default_branch: master | main   # base for PRs
#       submodule_path: .ai-playbook    # (optional, defaults to .ai-playbook)
#       personal: true | false          # (optional) personal add-on repo
#       visibility: public | private    # (optional, for audit)
#       status: active | paused | archived  # paused = skip automation
#       notes: free text                # (optional)
#       skills_pins:                    # (optional) per-source-repo
#         <source-repo-slug>: <semver>  # tag pin for skills materialisation.
#                                       # Source slugs match the source repo's
#                                       # bare name (e.g. `ai-playbook`).
#                                       # Absence of a key = consumer doesn't
#                                       # pull from that source.
#       tracker_kind: github | jira     # REQUIRED — the issue-tracker surface
#                                       # this consumer publishes change-tracking
#                                       # tickets on. `github` = the consumer's
#                                       # own GitHub Issues / Projects. `jira` =
#                                       # the explicit jira_project below.
#                                       # No silent fallback: if this is missing
#                                       # for an active consumer, automation
#                                       # fails loudly. Read by issue_sync.py
#                                       # decide_surface() and validated by the
#                                       # consumers-schema CI check.
#       jira_project: <KEY>             # REQUIRED iff tracker_kind == jira.
#                                       # The Jira project key. Ignored when
#                                       # tracker_kind == github.
#
# Automation consumers of this file:
#   - .github/workflows/propagate-playbook-bump.yml (event-driven on tag push)
#   - scripts/bump_consumers.py (manual CLI; merges with projects.yaml for
#     resolution of local paths when run interactively)

schema: ai-playbook/consumers/v1
version: 1

# Mock entries below illustrate the three common shapes. Replace with your own
# in a local (gitignored) `consumers.yaml`. The mock data is NOT used by any
# automation — it exists purely for new contributors to see the schema in
# concrete form.

consumers:
  consumer-a:
    repo: <org>/consumer-a
    default_branch: main
    visibility: public
    status: active
    tracker_kind: github
    notes: Example public OSS consumer.
    skills_pins:
      ai-playbook: v0.4.0

  consumer-b:
    repo: <org>/consumer-b
    default_branch: master
    visibility: private
    status: active
    tracker_kind: github
    notes: Example private internal consumer.
    skills_pins:
      ai-playbook: v0.4.0

  consumer-c:
    repo: <org>/consumer-c
    default_branch: main
    visibility: private
    status: active
    tracker_kind: jira
    jira_project: EXAMPLE
    notes: Example consumer routing change-tracking through Jira.
    skills_pins:
      ai-playbook: v0.4.0

# mcp-servers-base.yaml — well-known MCP server templates (playbook SSOT base layer).
#
# This file ships UNIVERSAL templates only — servers that any Wizarck-org
# consumer (or fork) would plausibly use, with no tenant- or person-specific
# names baked in. Tenant-named instances (google-workspace-<your-tenant>,
# trello-<your-tenant>, atlassian-<your-instance>) live in the dev's personal
# layer at `~/.config/mcp-servers.yaml`. A starter template for that personal
# layer ships at `templates/mcp-servers-personal.yaml.example` — copy to
# `~/.config/mcp-servers.yaml` and customise.
#
# 3-layer merge precedence: personal > project > base, field-by-field deep merge.
# Render pipeline: `python scripts/mcp/render.py --project <name>`.
#
# Fields per server entry:
#   id                canonical short-form (must match the map key)
#   description       one-sentence intent, readable by an LLM agent
#   transport         stdio | http
#   endpoint          http URL (only when transport == http; null = override per-layer)
#   command           stdio launcher command (only when transport == stdio)
#   env:
#     required        [ENV_VAR_NAMES] — render refuses if any is unset at merge time
#     optional        [ENV_VAR_NAMES]
#   auth              none | bearer | oauth | cf-access
#   scope             universal — every entry in THIS file is universal.
#                     Personal-named instances live in the personal layer file.
#   capabilities_hint [short tokens used by router/health checks]

schema: mcp-servers/v1
version: 0.3.0
layer: base

servers:

  hindsight:
    id: hindsight
    description: Episodic memory + semantic recall. Cross-project durable layer; bank_id scopes per project.
    transport: http
    endpoint: null  # consumers override to point at their Hindsight deployment
    command: null
    env:
      required: [HINDSIGHT_URL, HINDSIGHT_BANK_ID]
      optional: [CF_ACCESS_CLIENT_ID, CF_ACCESS_CLIENT_SECRET, HINDSIGHT_API_KEY, HINDSIGHT_TIMEOUT_MS]
    auth: cf-access
    scope: universal
    capabilities_hint: [recall, retain, search, timeline]

  litellm:
    id: litellm
    description: LLM routing + budget + fallback proxy in front of Anthropic/OpenAI/local models.
    transport: http
    endpoint: null
    command: null
    env:
      required: [LITELLM_URL, LITELLM_MASTER_KEY]
      optional: [LITELLM_PROJECT, LITELLM_DEFAULT_MODEL]
    auth: bearer
    scope: universal
    capabilities_hint: [completion, routing, fallback]

  guardrails-mcp:
    id: guardrails-mcp
    description: "Prompt-injection + policy filter MCP. Planned — lands in T10 / Phase 5 T26."
    transport: http
    endpoint: null
    command: null
    env:
      required: [GUARDRAILS_URL, GUARDRAILS_API_KEY]
      optional: [GUARDRAILS_POLICY_PROFILE]
    auth: bearer
    scope: universal
    capabilities_hint: [filter, classify, policy]

  atlassian:
    id: atlassian
    description: Jira Cloud + Confluence (generic; tenant-specific instances live in the personal layer).
    transport: http
    endpoint: null
    command: null
    env:
      required: [ATLASSIAN_URL, ATLASSIAN_API_TOKEN]
      optional: [ATLASSIAN_USERNAME, ATLASSIAN_DEFAULT_PROJECT]
    auth: cf-access
    scope: universal
    capabilities_hint: [jira-search, jira-issue, confluence-search]

  google-workspace:
    id: google-workspace
    description: Gmail + Drive + Calendar (generic; per-tenant instances live in the personal layer).
    transport: http
    endpoint: null
    command: null
    env:
      required: [GOOGLE_OAUTH_TOKEN, GOOGLE_CLIENT_ID]
      optional: [GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN]
    auth: oauth
    scope: universal
    capabilities_hint: [gmail, drive, calendar]

  trello:
    id: trello
    description: Trello cards + boards (generic; per-account instances live in the personal layer).
    transport: http
    endpoint: null
    command: null
    env:
      required: [TRELLO_API_KEY, TRELLO_TOKEN]
      optional: [TRELLO_DEFAULT_BOARD_ID]
    auth: bearer
    scope: universal
    capabilities_hint: [trello-card, trello-board, trello-list]

  skills-registry:
    id: skills-registry
    description: Central skills discovery + catalog service — agents query it before planning.
    transport: http
    endpoint: null
    command: null
    env:
      required: [SKILLS_REGISTRY_URL]
      optional: [SKILLS_REGISTRY_API_KEY]
    auth: none
    scope: universal
    capabilities_hint: [skills-list, skills-describe, skills-search]

  crm:
    id: crm
    description: Twenty CRM read-only access (contacts, companies, deals).
    transport: http
    endpoint: null
    command: null
    env:
      required: [TWENTY_API_URL, TWENTY_API_KEY]
      optional: [TWENTY_DEFAULT_WORKSPACE]
    auth: bearer
    scope: universal
    capabilities_hint: [crm-contact, crm-company, crm-deal]

  rag:
    id: rag
    description: Local vault + codebase RAG search (Obsidian vault + project source).
    transport: stdio
    endpoint: null
    command: "python -m consumer-d.rag"
    env:
      required: [RAG_VAULT_PATH]
      optional: [RAG_INDEX_PATH, RAG_TOP_K]
    auth: none
    scope: universal
    capabilities_hint: [vault-search, code-search, semantic-search]

.card a.title { color: #18181b; text-decoration: none; font-size: 17px; font-weight: 600; display: block; margin-bottom: 4px; }
.card a.title:hover { text-decoration: underline; }
.card .desc { color: #52525b; font-size: 13px; line-height: 1.55; margin-top: 6px; }
.card .vibe { font-size: 12px; font-weight: 500; color: #15803d; margin-top: 10px; padding-top: 10px; border-top: 1px solid #f4f4f5; }
.tier-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #71717a; margin: 4px 0 10px; }
.aside-links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
.aside-links a { font-size: 13px; color: #2E8B85; text-decoration: none; padding: 6px 12px; border: 1px solid #d4d4d8; border-radius: 6px; }
footer { margin-top: 36px; padding-top: 18px; border-top: 1px solid #e4e4e7; color: #71717a; font-size: 12px; }

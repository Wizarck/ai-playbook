# =============================================================================
# Namespace-scoped ServiceAccount + Role + RoleBinding
# =============================================================================
# Per multi-layer-defense-single-operator.md L4 (State / RBAC).
# Default-deny stance: declare only the verbs the workload needs.
#
# Usage:
#   1. Replace {{namespace}}, {{service-name}}, {{verbs}}, {{resources}}.
#   2. Verify by attempted denial:
#        kubectl auth can-i delete pods --as system:serviceaccount:{{namespace}}:{{service-name}} -n {{namespace}}
#        # MUST return "no" unless `delete` and `pods` are explicitly listed below.
#   3. Apply:
#        kubectl apply -f serviceaccount.yaml
# =============================================================================

apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{service-name}}
  namespace: {{namespace}}
automountServiceAccountToken: true  # default; set false if pod doesn't need k8s API
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{service-name}}-role
  namespace: {{namespace}}
rules:
  # Example: read-only on configmaps + secrets in same namespace
  - apiGroups: [""]
    resources: ["configmaps", "secrets"]
    verbs: ["get", "list", "watch"]
  # Example: read+write on a specific resource (e.g. Job for cron-driven tasks)
  # - apiGroups: ["batch"]
  #   resources: ["jobs"]
  #   verbs: ["get", "list", "watch", "create"]
  # NEGATIVE LIST (verify these return "no"):
  # - delete pods
  # - access other namespaces
  # - cluster-scoped resources (nodes, persistentvolumes)
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{service-name}}-binding
  namespace: {{namespace}}
subjects:
  - kind: ServiceAccount
    name: {{service-name}}
    namespace: {{namespace}}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{service-name}}-role

# Pre-commit config for {{PROJECT_NAME}}. Inherits hooks from the ai-playbook submodule.
# Bootstrap: `pip install pre-commit && pre-commit install` after cloning.
#
# Hooks inside the `playbook-hooks` marker block below (between its ai-playbook
# begin/end comment lines) are playbook-managed and overwritten on
# `apply_config` / `bootstrap --update`. Add project-specific hooks OUTSIDE that
# block — they will be preserved across re-renders. See
# .ai-playbook/specs/fusion-integration-pattern.md §8 for guidance on tailoring
# this template.

# Hooks without `stages:` run at pre-commit only, even once another hook type is
# installed (e.g. commit-msg, for block-manual-spec-edit below).
default_stages: [pre-commit]

repos:
# >>> ai-playbook:begin id=playbook-hooks >>>
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v4.6.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-json
      - id: check-added-large-files
        args: [--maxkb=500]

  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.18.4
    hooks:
      - id: gitleaks

  # Each playbook hook skips (exit 0) while its script is missing — no submodule,
  # or one not initialised yet — and otherwise passes the validator's exit code on.
  - repo: local
    hooks:
      - id: schema-validate-agents
        name: Validate AGENTS.md against playbook schema
        entry: bash -c '[ ! -f .ai-playbook/scripts/schema_validate.py ] || python .ai-playbook/scripts/schema_validate.py AGENTS.md'
        language: system
        pass_filenames: false
        files: ^AGENTS\.md$

      - id: mcp-validate
        name: Validate mcp-servers.yaml layering
        entry: bash -c '[ ! -f .ai-playbook/scripts/mcp/validate.py ] || python .ai-playbook/scripts/mcp/validate.py'
        language: system
        pass_filenames: false
        files: ^mcp-servers\.yaml$|^mcp-servers\.project\.yaml$

      # No-op until the project declares a `wiring.yaml`. `always_run` is
      # deliberate: the population is any source file, so there is no useful
      # `files:` filter — and the bug this catches is "capability changed,
      # registry untouched", which a filter on the registry would hide.
      - id: capability-wiring
        name: Capability is wired into its registry (code-entropy axis 4)
        entry: bash -c '[ ! -f wiring.yaml ] || [ ! -f .ai-playbook/scripts/rules/capability-wiring.rule.py ] || python .ai-playbook/scripts/rules/capability-wiring.rule.py check --changed-only'
        language: system
        pass_filenames: false
        always_run: true

      # No-op until the project declares a `repo-hygiene.yaml`. `--changed-only`
      # narrows on the MANIFEST, so the ordinary commit that touches no manifest
      # pays only the artefact probes (a few stat calls) and skips the corpus
      # walk entirely.
      - id: repo-hygiene
        name: Dependencies are used, artefacts are ignored and fresh (code-entropy axes 3+5)
        entry: bash -c '[ ! -f repo-hygiene.yaml ] || [ ! -f .ai-playbook/scripts/rules/repo-hygiene.rule.py ] || python .ai-playbook/scripts/rules/repo-hygiene.rule.py check --changed-only'
        language: system
        pass_filenames: false
        always_run: true

      - id: verdict-lint
        name: Lint review/verify verdict shape (verdict-contract.md)
        entry: bash -c '[ ! -f .ai-playbook/scripts/verdict_lint.py ] || python .ai-playbook/scripts/verdict_lint.py --shape artifact "$@"' --
        language: system
        files: ^openspec/changes/.*/(review|verify)\.md$

      # OPTIONAL — enable only if this project archives OpenSpec changes into
      # openspec/specs/ via the archive workflow. Projects using a custom
      # workflow that does NOT promote specs post-archive (e.g. project-a's
      # project-a-team schema) should leave this disabled. See AGENTS.md §7.5.
      # Runs at the commit-msg stage (the commit's message does not exist yet at
      # pre-commit time); install it with `pre-commit install --hook-type commit-msg`
      # (or list both in top-level `default_install_hook_types: [pre-commit, commit-msg]`).
      # Keep top-level `default_stages: [pre-commit]` (add it if your file predates
      # it), or every hook without `stages:` runs a second time at commit-msg.
      # For CI (`pre-commit run --from-ref/--to-ref`) add a pre-commit-stage copy
      # without --commit-msg-file; locally that copy defers to this one.
      # - id: block-manual-spec-edit
      #   name: Block manual edits to openspec/specs/
      #   entry: bash -c '[ ! -f .ai-playbook/scripts/block_manual_spec_edit.py ] || exec python .ai-playbook/scripts/block_manual_spec_edit.py --commit-msg-file "$1"' --
      #   language: system
      #   stages: [commit-msg]
      #   pass_filenames: true

      # OPTIONAL — enable only if this project calls LLMs directly from code
      # (e.g. via anthropic / openai SDKs in production paths). Projects that
      # do NOT call LLMs directly (e.g. backend-only data sync services)
      # should leave this disabled. See AGENTS.md §7.5.
      # - id: verify-llm-routing
      #   name: Verify LLM routing (Change C drift detector — direct-SDK callers)
      #   entry: bash -c '[ ! -f .ai-playbook/scripts/verify_llm_routing.py ] || python .ai-playbook/scripts/verify_llm_routing.py'
      #   language: system
      #   pass_filenames: false
      #   # Warn-only initially per ai-playbook D3.5; promote to --strict after
      #   # 30 days of green builds. Migrate offending callers to
      #   # `.ai-playbook.scripts._llm.call(task_class, ...)` — see
      #   # `.ai-playbook/specs/model-routing.md` §1 for the task-class taxonomy.
      #   always_run: true
# <<< ai-playbook:end playbook-hooks <<<
